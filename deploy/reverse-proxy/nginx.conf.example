# This file is included from nginx's http context. Replace the hostname and
# certificate paths. Keep every application service on loopback.
limit_conn_zone $binary_remote_addr zone=latex_renderer_connections:10m;
limit_req_zone $binary_remote_addr zone=latex_renderer_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=latex_renderer_api:10m rate=120r/m;

server {
  listen 443 ssl http2;
  server_name latex.example.com;
  ssl_certificate /etc/letsencrypt/live/latex.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/latex.example.com/privkey.pem;
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  client_max_body_size 220m;
  client_body_timeout 60s;
  client_header_timeout 20s;
  keepalive_timeout 30s;
  send_timeout 360s;
  limit_conn latex_renderer_connections 20;
  limit_conn_status 429;
  limit_req_status 429;

  proxy_set_header Host latex.example.com;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host latex.example.com;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header Forwarded "";
  proxy_set_header X-Latex-Renderer-Client-IP $remote_addr;
  proxy_set_header CF-Access-Jwt-Assertion "";
  proxy_set_header CF-Connecting-IP "";
  proxy_redirect off;
  proxy_connect_timeout 5s;
  proxy_send_timeout 120s;
  proxy_read_timeout 360s;


  location = /api/v1/render-tickets { limit_req zone=latex_renderer_api burst=20 nodelay; proxy_pass http://127.0.0.1:3105; }
  location = /api/v1/source-tickets { limit_req zone=latex_renderer_api burst=20 nodelay; proxy_pass http://127.0.0.1:3105; }
  location ^~ /api/v1/job-tickets/ { limit_req zone=latex_renderer_api burst=20 nodelay; proxy_pass http://127.0.0.1:3105; }
  location = /api/v1/projects { limit_req zone=latex_renderer_api burst=20 nodelay; proxy_pass http://127.0.0.1:3105; }
  location ^~ /api/v1/projects/ { limit_req zone=latex_renderer_api burst=20 nodelay; proxy_pass http://127.0.0.1:3105; }

  location ~ ^/\.well-known/oauth-(authorization-server|protected-resource) { proxy_pass http://127.0.0.1:3104; }
  location ~ ^/(oauth|mcp)(/|$) { proxy_pass http://127.0.0.1:3104; }
  location = /auth/password/login { limit_req zone=latex_renderer_login burst=5 nodelay; proxy_pass http://127.0.0.1:3102; }
  location ~ ^/(auth|admin/api|admin/v1|app/api)(/|$) { proxy_pass http://127.0.0.1:3102; }
  location ^~ /api/ { proxy_pass http://127.0.0.1:3100; }

  location @latex_renderer_legacy_api_health { proxy_pass http://127.0.0.1:3105; }
  location = /api/v1/health {
    proxy_pass http://unix:/run/latex-renderer-status/status.sock;
    proxy_intercept_errors on;
    error_page 502 504 = @latex_renderer_legacy_api_health;
  }
  location = /health {
    proxy_pass http://unix:/run/latex-renderer-status/status.sock;
    proxy_intercept_errors on;
    error_page 502 504 = @latex_renderer_web;
  }
  location = /health/rendering { proxy_pass http://unix:/run/latex-renderer-status/status.sock; }
  location = /health/status { proxy_pass http://unix:/run/latex-renderer-status/status.sock; }

  location @latex_renderer_web { proxy_pass http://127.0.0.1:3101; }
  location = / {
    root /opt/latex-renderer/current/apps/public-web/dist;
    try_files /index.html @latex_renderer_web;
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header Cache-Control "public, max-age=0, must-revalidate, no-transform" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  }
  location ~ ^/(?:docs(?:/|$)|downloads(?:/|$)|assets/(?:styles\.css|site\.js|login\.js|docs-search\.json)$|openapi/(?:gateway|renderer)\.openapi\.yaml$) {
    root /opt/latex-renderer/current/apps/public-web/dist;
    try_files $uri $uri/index.html @latex_renderer_web;
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header Cache-Control "public, max-age=0, must-revalidate, no-transform" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  }
  location / { proxy_pass http://127.0.0.1:3101; }
}

server {
  listen 80;
  server_name latex.example.com;
  return 308 https://latex.example.com$request_uri;
}
