{
  "root": "/srv/texlive-ci",
  "public_base_url": "https://texlive-ci.example.invalid",
  "upstream_base_url": "https://texlive.info/tlnet-archive",
  "active_year": 2026,
  "architectures": ["amd64"],
  "validation_collections": ["collection-langenglish", "collection-langjapanese"],
  "profile": "/etc/texlive-ci/texlive.profile",
  "keyring": "/etc/texlive-ci/texlive.gpg",
  "hard_limit_gib": 15,
  "gc_start_gib": 11,
  "gc_target_gib": 9,
  "sync_peak_limit_gib": 14,
  "os_free_min_gib": 3,
  "keep_generations": 3,
  "keep_hours": 72,
  "sync_timeout_minutes": 180,
  "ci_job_timeout_minutes": 360,
  "reservation_ttl_hours": 8,
  "max_reserved_snapshots": 2,
  "stale_update_hours": 48,
  "latest_lookback_days": 14,
  "metadata_headroom_mib": 256,
  "temporary_space_percent": 115,
  "hard_limit_enforcement": "application",
  "sync_enabled": false,
  "notify_command": []
}
