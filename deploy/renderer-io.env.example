# Optional additions to the private renderer.env. Do not replace that file.
# Values are bytes unless the name ends with _SECONDS. One MiB = 1,048,576 bytes.
# This is application Source input reuse, NOT the separate 15 GiB CI mirror.
SOURCE_TREE_MAX_BYTES=67108864
SOURCE_TREE_USER_MAX_BYTES=33554432
SOURCE_TREE_TTL_SECONDS=21600
# Set SOURCE_TREE_MAX_BYTES=0 to disable new fills and reuse. Ordinary validation
# and extraction still run, and the timer continues collecting expired data.
