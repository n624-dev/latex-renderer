GATEWAY_PUBLIC_ORIGIN=https://gateway.example.com
GATEWAY_PORT=3120
GATEWAY_DATABASE=/var/lib/latex-renderer-mcp-gateway/connections.sqlite
GATEWAY_CLIENTS_FILE=/etc/latex-renderer-mcp-gateway/clients.json
GATEWAY_REFRESH_KEY_FILE=/etc/latex-renderer-mcp-gateway/refresh.key
GATEWAY_PAIRING_KEY_FILE=/etc/latex-renderer-mcp-gateway/pairing.key
GATEWAY_REFERENCE_KEY_FILE=/etc/latex-renderer-mcp-gateway/reference.key
GATEWAY_HTTPS_KEY_FILE=/etc/latex-renderer-mcp-gateway/https.key
GATEWAY_BACKUP_DIRECTORY=/var/lib/latex-renderer-mcp-gateway/backups
GATEWAY_BACKUP_RECIPIENT_FILE=/etc/latex-renderer-mcp-gateway/backup-recipient.txt
GATEWAY_MAX_PENDING=64
GATEWAY_MAX_BODY_BYTES=8388608
GATEWAY_MAX_SOURCE_BYTES=20971520
GATEWAY_MAX_RESPONSE_BYTES=25165824
GATEWAY_MAX_DOWNLOAD_BYTES=209715200
GATEWAY_MAX_OPERATIONS=2
GATEWAY_MAX_AGENT_SOCKETS=32
GATEWAY_MAX_REGISTRATIONS=200
GATEWAY_REGISTRATIONS_PER_IP_MINUTE=10
GATEWAY_PAIR_ATTEMPTS_PER_TRANSPORT=10
GATEWAY_PAIR_ATTEMPTS_PER_INSTANCE=10
GATEWAY_PAIR_ATTEMPTS_TOTAL=100
GATEWAY_TIMEOUT_MS=60000
