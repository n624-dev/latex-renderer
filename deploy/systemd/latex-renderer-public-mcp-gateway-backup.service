[Unit]
Description=Encrypted backup of LaTeX Renderer MCP gateway connections

[Service]
Type=oneshot
User=latex-renderer-mcp-gateway
Group=latex-renderer-mcp-gateway
SupplementaryGroups=latex-renderer
WorkingDirectory=/opt/latex-renderer/current
StateDirectory=latex-renderer-mcp-gateway latex-renderer-mcp-gateway/backups
StateDirectoryMode=0700
EnvironmentFile=/etc/latex-renderer-mcp-gateway/gateway.env
ExecStart=/usr/local/bin/node apps/public-mcp-gateway/dist/backup-cli.js backup
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
InaccessiblePaths=/etc/latex-renderer /var/lib/latex-renderer
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
LimitCORE=0
