[Unit]
Description=Loopback activation socket for LaTeX Renderer admin-api

After=latex-renderer-authentication-recovery.service
Requires=latex-renderer-authentication-recovery.service

[Socket]
ListenStream=127.0.0.1:3102
Accept=no
Service=latex-renderer-admin-api.service
FileDescriptorName=http
Backlog=128

[Install]
WantedBy=sockets.target
