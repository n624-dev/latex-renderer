[Unit]
Description=Loopback activation socket for LaTeX Renderer admin-web

# Recovery is a normal service ordered after basic.target. These listeners
# start after it, rather than participating in the early sockets.target order.
DefaultDependencies=no
Before=shutdown.target
Conflicts=shutdown.target
After=latex-renderer-authentication-recovery.service
Requires=latex-renderer-authentication-recovery.service

[Socket]
ListenStream=127.0.0.1:3101
Accept=no
Service=latex-renderer-admin-web.service
FileDescriptorName=http
Backlog=128

[Install]
WantedBy=sockets.target
