[Unit]
Description=Refresh LaTeX Renderer validated latest TeX image
After=latex-renderer-image-manager.service
Requires=latex-renderer-image-manager.service

[Service]
Type=oneshot
User=root
Group=latex-renderer
WorkingDirectory=/opt/latex-renderer/current
Environment=IMAGE_MANAGER_URL=http://127.0.0.1:3110
Environment=IMAGE_REFRESH_MAX_WAIT_MS=16200000
LoadCredential=image-manager-token:/etc/latex-renderer/secrets/image-manager-token
ExecStart=/usr/local/bin/node deploy/scripts/run-image-refresh.mjs
TimeoutStartSec=4h40min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
