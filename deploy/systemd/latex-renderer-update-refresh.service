[Unit]
Description=Check latex-renderer immutable stable application release
After=network-online.target latex-renderer-image-manager.service latex-renderer-update-manager.service
Wants=network-online.target latex-renderer-image-manager.service latex-renderer-update-manager.service

[Service]
Type=oneshot
User=latex-renderer
Group=latex-renderer
WorkingDirectory=/opt/latex-renderer/current
Environment=UPDATE_MANAGER_SOCKET=/run/latex-renderer/update-manager.sock
Environment=UPDATE_MANAGER_TOKEN_FILE=%d/update-manager-token
LoadCredential=update-manager-token:/etc/latex-renderer/secrets/update-manager-token
ExecStart=/usr/local/bin/node deploy/scripts/run-update-refresh.mjs
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
