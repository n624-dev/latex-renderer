[Unit]
Description=Collect bounded application update recovery points
After=latex-renderer-update-manager.service

[Service]
Type=oneshot
User=root
# The root GC may be the first process to create the shared mutation lock.
# Match the non-root Update Manager's group without relaxing the explicitly
# private recovery-point files and directories.
Group=latex-renderer
UMask=0007
ExecStart=/usr/local/bin/node /usr/local/libexec/latex-renderer-update-recovery.mjs gc
TimeoutStartSec=5min
Nice=10
