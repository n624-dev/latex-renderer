[Unit]
Description=Loopback activation socket for LaTeX Renderer api

After=latex-renderer-authentication-recovery.service
Requires=latex-renderer-authentication-recovery.service

[Socket]
ListenStream=127.0.0.1:3100
Accept=no
Service=latex-renderer-api.service
FileDescriptorName=http
Backlog=128

[Install]
WantedBy=sockets.target
