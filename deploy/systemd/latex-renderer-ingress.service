[Unit]
Description=Dedicated LaTeX Renderer Standalone HTTPS ingress
After=network-online.target latex-renderer-authentication-recovery.service
Requires=latex-renderer-authentication-recovery.service
Wants=network-online.target

[Service]
Type=simple
User=latex-renderer
Group=latex-renderer
RuntimeDirectory=latex-renderer-ingress
RuntimeDirectoryMode=0750
ExecStartPre=/usr/sbin/nginx -t -c /etc/latex-renderer/ingress-nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/latex-renderer/ingress-nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGQUIT
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Both master and workers use the prepared service identity. Only binding the
# HTTPS port needs a capability; no runtime user/group transition is required.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/latex-renderer/ingress /run/latex-renderer-ingress
UMask=0027

[Install]
WantedBy=multi-user.target
