[Unit]
Description=Passive public health without waking application processes
After=latex-renderer-authentication-recovery.service
Requires=latex-renderer-authentication-recovery.service
DefaultDependencies=no
Before=shutdown.target
Conflicts=shutdown.target

[Socket]
ListenStream=/run/latex-renderer-status/status.sock
Accept=yes
SocketMode=0666
DirectoryMode=0755
MaxConnections=16
Backlog=32
RemoveOnStop=true

[Install]
WantedBy=sockets.target
