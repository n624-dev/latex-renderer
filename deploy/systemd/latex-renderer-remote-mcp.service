[Unit]
Description=LaTeX Renderer Remote MCP and OAuth Server
After=network-online.target latex-renderer-image-manager.service
Wants=network-online.target
Requires=latex-renderer-image-manager.service
PartOf=latex-renderer-image-manager.service

[Service]
Type=simple
User=latex-renderer
Group=latex-renderer
WorkingDirectory=/opt/latex-renderer/current
EnvironmentFile=/etc/latex-renderer/renderer.env
Environment=PORT=3104
ExecStart=/usr/local/bin/node apps/remote-mcp/dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/latex-renderer
UMask=0007

[Install]
WantedBy=multi-user.target
