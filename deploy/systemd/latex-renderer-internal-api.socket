[Unit]
Description=Loopback activation socket for LaTeX Renderer internal-api

After=latex-renderer-authentication-recovery.service
Requires=latex-renderer-authentication-recovery.service

[Socket]
ListenStream=127.0.0.1:3103
Accept=no
Service=latex-renderer-internal-api.service
FileDescriptorName=http
Backlog=128

[Install]
WantedBy=sockets.target
