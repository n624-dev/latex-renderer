[Unit]
Description=LaTeX Renderer public MCP gateway
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/latex-renderer/current/apps/public-mcp-gateway/dist/server.js

[Service]
User=latex-renderer-mcp-gateway
Group=latex-renderer-mcp-gateway
SupplementaryGroups=latex-renderer
WorkingDirectory=/opt/latex-renderer/current
StateDirectory=latex-renderer-mcp-gateway
StateDirectoryMode=0700
EnvironmentFile=/etc/latex-renderer-mcp-gateway/gateway.env
Environment=NODE_USE_SYSTEM_CA=1
ExecStart=/usr/local/bin/node apps/public-mcp-gateway/dist/server.js
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
InaccessiblePaths=/etc/latex-renderer /var/lib/latex-renderer
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
LimitCORE=0

[Install]
WantedBy=multi-user.target
