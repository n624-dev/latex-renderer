[Unit]
Description=Update cloudflared from the signed Cloudflare APT repository
Documentation=https://developers.cloudflare.com/tunnel/downloads/update-cloudflared/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cloudflared-update
TimeoutStartSec=15min
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
