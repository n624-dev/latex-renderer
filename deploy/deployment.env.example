# Root-only Cloudflare deployment identifiers. This file is not used for
# DEPLOYMENT_MODE=standalone. Do not commit the configured file.
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
CLOUDFLARE_TUNNEL_ID=REPLACE_WITH_TUNNEL_ID
CLOUDFLARE_ZONE_NAME=example.com
# Optional space-separated hostnames removed from remotely managed Tunnel ingress.
CLOUDFLARE_LEGACY_HOSTNAMES=
# Optional alternative to the deployment user's `wrangler login` session.
# CLOUDFLARE_API_TOKEN=REPLACE_WITH_SCOPED_TOKEN
