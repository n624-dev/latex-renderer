# Host-local, root-owned configuration installed as:
# /etc/latex-renderer/update-manager.env (mode 0600)
UPDATE_DEPLOY_USER=REPLACE_WITH_DEPLOYMENT_USER
# Release attestation verification is mandatory. install-host.sh installs the
# pinned GitHub CLI verifier when the distribution package is too old.
# UPDATE_MAX_BUNDLE_BYTES=1073741824
# Diagnostic logs only; operation result JSON remains for the management API.
# UPDATE_MAX_OPERATION_LOG_BYTES=4194304
# UPDATE_LOG_RETENTION_DAYS=7
# UPDATE_LOG_TOTAL_MAX_BYTES=41943040
# Collection: startup, before/after operations and every 15 minutes while running.
