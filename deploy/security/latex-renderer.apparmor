#include <tunables/global>

profile latex-renderer flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/fonts>
  #include <abstractions/perl>

  deny network,
  deny capability,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,
  signal (receive) peer=unconfined,

  /opt/renderer/compile.sh rix,
  /opt/renderer/*.cnf r,
  /opt/renderer/*.latexmkrc r,
  /opt/renderer/latexmkrc r,
  /opt/texlive/** rix,
  /usr/bin/env rix,
  /usr/bin/perl rix,
  /usr/bin/timeout rix,
  /usr/bin/pdftoppm rix,
  /usr/bin/pdfinfo rix,
  /usr/bin/identify-im6.q16 rix,
  /usr/bin/qpdf rix,
  /usr/bin/find rix,
  /usr/bin/awk rix,
  /usr/bin/mawk rix,
  /usr/bin/mkdir rix,
  /usr/bin/mv rix,
  /usr/bin/xargs rix,
  /usr/bin/timeout rix,
  /bin/sh rix,
  /usr/bin/dash rix,
  /etc/fonts/** r,
  /etc/ImageMagick-6/** r,
  /usr/share/fonts/** r,
  /usr/share/ImageMagick-6/** r,
  /usr/share/poppler/** r,
  /var/cache/fontconfig/** r,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /dev/null rw,
  /dev/urandom r,
  /proc/meminfo r,
  @{PROC}/@{pid}/fd/ r,
  /sys/devices/system/cpu/** r,
  /work/input/ r,
  /work/input/** r,
  /work/output/ rw,
  /work/output/** rwk,
  /tmp/ rw,
  /tmp/** rwk,

  deny /run/** rwklx,
  deny /var/run/** rwklx,
  deny /var/lib/** rwklx,
  deny /etc/shadow r,
}
