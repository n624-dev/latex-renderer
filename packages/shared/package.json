{
  "name": "@latex-renderer/shared",
  "version": "1.7.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resource-limits": {
      "types": "./dist/resource-limits.d.ts",
      "import": "./dist/resource-limits.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./login-redirect": {
      "types": "./dist/login-redirect.d.ts",
      "import": "./dist/login-redirect.js"
    },
    "./diagnostic-locale": {
      "types": "./dist/diagnostic-locale.d.ts",
      "import": "./dist/diagnostic-locale.js"
    },
    "./public-https": {
      "types": "./dist/public-https.d.ts",
      "import": "./dist/public-https.js"
    },
    "./bounded-body": {
      "types": "./dist/bounded-body.d.ts",
      "import": "./dist/bounded-body.js"
    },
    "./relay-rpc": {
      "types": "./dist/relay-rpc.d.ts",
      "import": "./dist/relay-rpc.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
