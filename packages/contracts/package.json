{
  "name": "@latex-renderer/contracts",
  "version": "1.7.2-rc.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer-mcp-definitions": {
      "types": "./dist/renderer-mcp-definitions.d.ts",
      "import": "./dist/renderer-mcp-definitions.js"
    },
    "./renderer-mcp-messages": {
      "types": "./dist/renderer-mcp-messages.d.ts",
      "import": "./dist/renderer-mcp-messages.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
