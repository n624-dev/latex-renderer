{
  "name": "@latex-renderer/gateway-worker",
  "version": "1.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --config wrangler.example.jsonc --dry-run --outdir dist",
    "typecheck": "wrangler types --config wrangler.example.jsonc --check && tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev --config wrangler.jsonc --local",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "check:startup": "wrangler check startup --config wrangler.example.jsonc"
  },
  "dependencies": {
    "@latex-renderer/contracts": "workspace:*",
    "hono": "^4.9.2",
    "zod": "^4.0.17"
  }
}
